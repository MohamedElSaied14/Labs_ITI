{
  "info": {
    "name": "Posts Management API",
    "description": "Test collection for the PHP REST API lab",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token",    "value": "" }
  ],
  "item": [
    {
      "name": "1. Login (get JWT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Automatically save the token for subsequent requests",
              "var json = pm.response.json();",
              "if (json.data && json.data.token) {",
              "    pm.collectionVariables.set('token', json.data.token);",
              "    console.log('Token saved!');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/auth/login",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}"
        }
      }
    },
    {
      "name": "2. GET all posts (public)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/posts"
      }
    },
    {
      "name": "3. GET single post (public)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/posts/1"
      }
    },
    {
      "name": "4. GET post not found (404)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/posts/9999"
      }
    },
    {
      "name": "5. POST create post (protected)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/posts",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"My New Post Title\",\n  \"content\": \"This is the body of my new post.\"\n}"
        }
      }
    },
    {
      "name": "6. POST create — validation error (422)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/posts",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Hi\"\n}"
        }
      }
    },
    {
      "name": "7. POST create — no token (401)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/posts",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Test\",\n  \"content\": \"Test content here\"\n}"
        }
      }
    },
    {
      "name": "8. PUT update post (protected)",
      "request": {
        "method": "PUT",
        "url": "{{base_url}}/api/posts/1",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Post Title\",\n  \"content\": \"Updated content for this post.\"\n}"
        }
      }
    },
    {
      "name": "9. DELETE post (protected)",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/api/posts/2",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ]
      }
    }
  ]
}
